# Keep the Gradle wrapper versioned:
# gradlew
# gradlew.bat
# gradle/wrapper/gradle-wrapper.jar
# gradle/wrapper/gradle-wrapper.properties
#
# Keep build configuration files versioned:
# settings.gradle
# settings.gradle.kts
# build.gradle
# build.gradle.kts
# gradle.properties
# gradle/libs.versions.toml